# Local Worker variables only. Copy to apps/worker/.dev.vars and replace locally.
# Never commit credentials. Privileged values belong in Cloudflare Worker secrets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-a-publishable-key
APP_ORIGINS=http://localhost:4321,http://localhost:4322,http://localhost:4323
# This privileged key is server-only. Never set it in an Astro app or browser bundle.
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-service-role-key
# R2 credentials are unnecessary for the configured binding and must not be added here.
